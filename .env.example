# Copy to `.env` and fill in the blanks. `.env` is gitignored.
# Add every new variable here in the same commit that introduces it.
#
# Secrets are server-side only: never give one a VITE_ prefix, which would
# inline it into the browser bundle. Generate a 64-character secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# =============================================================================
# Required
# =============================================================================

# Google AI Studio key (https://aistudio.google.com/apikey).
# Without it the voice assistant falls back to keyword matching.
GEMINI_API_KEY=""

# Atlas connection string (Connect -> Drivers -> Node.js). Percent-encode
# special characters in the password. A connection TIMEOUT means this machine's
# IP is missing from the Atlas Network Access allowlist, not a wrong URI.
MONGODB_URI=""

# Signs login tokens. 32+ characters. Must be the SAME value locally and on the
# deploy, and must NOT be rotated: it also seeds review links, which would all
# stop working.
JWT_SECRET=""

# Sarvam TTS key (https://dashboard.sarvam.ai), for spoken Punjabi.
# Without it (and without GOOGLE_TTS_API_KEY below), Punjabi voice stays silent.
SARVAM_API_KEY=""

# Which screens read from the API: "all", a comma-separated list
# (home, passport, jobs, kamai, profile), or "" for localStorage only.
# Inlined at build time: restart the dev server, or redeploy, after changing it.
VITE_USE_API="all"

# =============================================================================
# Demo login (stage only)
# =============================================================================
# A fixed code for one worker phone and the customer demo account, so the demo
# does not depend on SMS. Off unless DEMO_OTP_ENABLED is "true" and the codes
# are six digits. The customer code must differ from the worker code.
# Never commit real codes.

DEMO_OTP_ENABLED="false"
DEMO_OTP_PHONE="+919876543210"
DEMO_OTP_CODE=""
DEMO_CUSTOMER_OTP_CODE=""

# =============================================================================
# Booking commitments & reliability
# =============================================================================
# See KAARIGAR_RELIABILITY_FEATURE.md and docs/SWEEPER.md.

# Master switch. Leave "false" until the rehearsal passes with it on; false
# behaves exactly as the app did before the feature existed.
BOOKINGS_ENABLED="false"

# Keys the 4-digit arrival code. 32+ characters, and a different value from
# JWT_SECRET. Safe to rotate.
CHECKIN_OTP_SECRET=""

# Sent by the external cron as the x-sweep-secret header to
# POST /api/internal/sweep. 32+ characters. Unset means the sweep answers 404.
SWEEP_SECRET=""

# =============================================================================
# Optional - uncomment to override. Defaults shown.
# =============================================================================

# --- Server ---
# MONGODB_DB_NAME="kaarigar"          # the deploy uses kaarigar_sih_demo; never seed it with --reset
# PUBLIC_ORIGIN=""                    # origin QR codes encode; set before printing any QR
# PORT="3000"                         # hosting platforms set this themselves
# NODE_ENV="development"              # "production" serves the built dist/
# DISABLE_HMR="false"                 # "true" turns off hot reload and file watching

# --- Extra secrets (each falls back to a key derived from JWT_SECRET) ---
# REVIEW_LINK_SECRET=""               # signs customer review links; changing it breaks sent links
# TTS_URL_SECRET=""                   # signs private voice playback URLs

# --- Voice ---
# GOOGLE_TTS_API_KEY=""               # backup TTS provider if Sarvam is down

# --- Booking windows (minutes unless the name says hours) ---
# ACCEPT_WINDOW_URGENT_MIN="30"       # first reply to an urgent request
# ACCEPT_WINDOW_NORMAL_MIN="240"      # first reply to a normal request
# SCHEDULE_WINDOW_MIN="1440"          # pick a time slot after the price is agreed
# ARRIVAL_GRACE_MIN="60"              # arrive-by = slot end + this
# NO_SHOW_AFTER_MIN="1440"            # late becomes no-show after this
# RESCHEDULE_MIN_NOTICE_H="12"        # notice needed to change the time
# LATE_CANCEL_NOTICE_H="12"           # a worker cancel inside this counts as late
# MAX_RESCHEDULES="1"                 # 0 turns reschedules off
# CHECKIN_OTP_MAX_ATTEMPTS="5"        # wrong arrival codes before check-in locks
# CHECKIN_LOCK_MIN="15"               # how long check-in stays locked
# MAX_SLOT_HOURS="12"
# MAX_SLOT_DAYS_AHEAD="14"
# SWEEP_BATCH_SIZE="200"              # bookings one sweep handles per rule
#
# To show LATE -> NO_SHOW on stage without waiting a day, temporarily set
# the arrival grace and no-show windows to 1, and the normal accept and
# schedule windows to 2, then call the sweep. Put them back afterwards.

# --- Scripts ---
# TEST_BASE_URL="http://localhost:3000"   # target for npm run test:regressions

# Firebase (VITE_FIREBASE_*) is not used: login is OTP + JWT, and nothing reads
# those keys.
