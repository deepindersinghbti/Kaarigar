# Copy this file to `.env` and fill in real values. `.env` is gitignored (.gitignore:7).
#
# STANDING RULE (MIGRATION_PLAN.md, P3): every new key is added to this file in the
# SAME COMMIT that introduces it. This file is the only signal the other tracks get
# that a new variable exists. A key added without it produces `undefined` at runtime
# with no indication of what is missing.

# --- Required ---

# GEMINI_API_KEY: server-side only, never exposed to the browser.
# Read at server.ts:11,13 and reported (presence only) at server.ts:33 via /api/health.
# Without it, getGenAI() returns null and EVERY /api/assistant/process request silently
# falls through to fallbackProcessVoiceInput (server.ts:131) — the keyword matcher.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# MONGODB_URI: Atlas connection string (Connect -> Drivers -> Node.js).
# Server-side only, read at src/server/db.ts. Never reaches the browser.
# Format: mongodb+srv://<user>:<password>@<cluster>.<hash>.mongodb.net/?retryWrites=true&w=majority
# If the password contains @ : / ? # [ ] or %, it must be percent-encoded.
# A CONNECTION TIMEOUT here means this machine's IP is missing from the Atlas
# Network Access allowlist — not a wrong URI or password. Check that first.
MONGODB_URI=""

# JWT_SECRET: signs access and refresh tokens for the fallback OTP auth path.
# Server-side only, real secret, minimum 32 characters. The server refuses to
# sign or verify without it rather than falling back to a default - a
# predictable signing key is indistinguishable from no authentication at all.
#
# MUST BE BYTE-IDENTICAL ACROSS LOCAL AND DEPLOYED ENVIRONMENTS. If it is not,
# a token issued locally fails verification against the deploy and vice versa,
# and the symptom is a 401 that reads as a bug in the verification code. Two
# people will debug the middleware before either checks the secret. Generate it
# ONCE and distribute it through the agreed P3 channel.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# --- Firebase phone auth (P4) ---
#
# These four are CLIENT-side and are NOT secrets. Firebase web config is
# designed to ship in the browser bundle; access is controlled by Authorized
# Domains and Security Rules, not by hiding the apiKey. That is why they carry
# the VITE_ prefix, which deliberately exposes them to the client bundle.
#
# The Firebase ADMIN service account is a different thing entirely and is a real
# secret. It is server-side only, has no VITE_ prefix, and lands with Day 2's
# requireAuth middleware.
#
# Console -> Project settings -> General -> Your apps -> SDK setup and configuration.
# Vite reads .env only at startup: restart the dev server after editing these.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# --- Optional ---

# MONGODB_DB_NAME: database inside the cluster. Defaults to "kaarigar".
# MONGODB_DB_NAME="kaarigar"

# PORT: listening port, defaults to 3000. Render/Railway/Fly inject this
# themselves, so it normally stays unset locally and untouched in the platform.
# PORT="3000"

# NODE_ENV: "production" serves the built dist/ (server.ts:371); anything else runs Vite dev middleware.
# NODE_ENV="development"

# DISABLE_HMR: "true" disables hot module reload and file watching (vite.config.ts:17,19).
# DISABLE_HMR="false"
